# Copy to .env and adjust. Every value is optional.

# Port on the host machine.
CVFREE_PORT=3000

# Interface the port is published on. With the https profile use 127.0.0.1,
# so the app is only reachable through Caddy.
CVFREE_BIND=0.0.0.0

# Protect the app with a password. Strongly recommended on a public server.
CVFREE_PASSWORD=

# Bearer token for the MCP endpoint (/mcp), so an AI assistant can edit your resumes.
# Any long random string works: openssl rand -hex 32
# With a password set and no token, the endpoint stays off.
CVFREE_MCP_TOKEN=

# Your domain, used by the optional HTTPS proxy (docker compose --profile https up -d).
# Point its DNS A record to the server first.
DOMAIN=cv.example.com

# Optional AI review and tailoring. Any OpenAI-compatible API works.
# OpenAI:      AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
# OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1
# Ollama:      AI_BASE_URL=http://host.docker.internal:11434/v1   AI_MODEL=llama3.1   (no key)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Use a prebuilt image instead of building locally, for example ghcr.io/samuelbelo/cvfree:latest
# CVFREE_IMAGE=
